local allFrames = {
	statusFrame,
	moveFrame,
	orbitFrame,
	cameraFrame,
	infoFrame
}

local function switchTab(index)
	for i, frame in ipairs(allFrames) do
		frame.Visible = (i == index)
	end

	for i, button in ipairs(tabButtons) do
		if i == index then
			button.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			button.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
			button.TextColor3 = Color3.fromRGB(200, 200, 220)
		end
	end

	if index == 1 then
		updateStatus()
	end
end

for i, button in ipairs(tabButtons) do
	button.Activated:Connect(function()
		switchTab(i)
	end)
end

