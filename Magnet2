-- =========================================================
-- FOLLOW SYSTEM
-- =========================================================

local function getMyRoot()
	local character = localPlayer.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getTargetRoot()
	local target = getTarget()

	if not target or not target.Character then
		return nil
	end

	return target.Character:FindFirstChild("HumanoidRootPart")
end

local function calculatePosition(targetRoot)
	if orbitEnabled then
		local radians = math.rad(orbitAngle)

		local offset = Vector3.new(
			math.cos(radians) * orbitRadius,
			0,
			math.sin(radians) * orbitRadius
		)

		return targetRoot.Position + offset
	end

	if not currentPosition then
		return nil
	end

	for _, position in ipairs(positions) do
		if position.name == currentPosition then
			return (targetRoot.CFrame * position.offset).Position
		end
	end

	return nil
end

local function updateFollow(deltaTime)
	local myRoot = getMyRoot()
	local targetRoot = getTargetRoot()

	if not myRoot or not targetRoot then
		return
	end

	if orbitEnabled then
		orbitAngle += orbitSpeed * deltaTime * orbitDirection

		if orbitAngle >= 360 then
			orbitAngle -= 360
		elseif orbitAngle <= -360 then
			orbitAngle += 360
		end
	end

	local targetPosition = calculatePosition(targetRoot)

	if not targetPosition then
		return
	end

	local currentPositionVector = myRoot.Position
	local newPosition = currentPositionVector:Lerp(
		targetPosition,
		math.clamp(FOLLOW_SMOOTHNESS * deltaTime, 0, 1)
	)

	-- Die Bewegung wird relativ zur Zielposition berechnet.
	-- Die Blickrichtung von MagnetRed bleibt dabei unabhängig
	-- vom Kamera-System.
	local currentRotation = myRoot.CFrame - myRoot.CFrame.Position

	myRoot.CFrame = CFrame.new(newPosition) * currentRotation

	if orbitEnabled then
		followStatus.Text =
			"Orbit aktiv | Radius: " ..
			tostring(orbitRadius) ..
			" | Speed: " ..
			tostring(orbitSpeed) ..
			"°/s"
	else
		followStatus.Text =
			"Position: " ..
			tostring(currentPosition or "Keine") ..
			" | Abstand: 6 Studs"
	end
end

followConnection = RunService.RenderStepped:Connect(function(deltaTime)
	updateFollow(deltaTime)
end)

-- =========================================================
-- KAMERA SYSTEM
-- =========================================================

local function getCameraDirection(targetRoot)
	local forward = targetRoot.CFrame.LookVector
	local right = targetRoot.CFrame.RightVector

	if cameraMode == "Vorne" then
		return forward

	elseif cameraMode == "Hinten" then
		return -forward

	elseif cameraMode == "Links" then
		return -right

	elseif cameraMode == "Rechts" then
		return right

	elseif cameraMode == "Links vorne" then
		return (forward - right).Unit

	elseif cameraMode == "Rechts vorne" then
		return (forward + right).Unit
	end

	return forward
end

cameraConnection = RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	camera.FieldOfView = cameraFOV

	local targetRoot = getTargetRoot()

	if not targetRoot then
		return
	end

	local direction = getCameraDirection(targetRoot)

	-- Nur die Blickrichtung wird verändert.
	-- Die Position von MagnetRed bleibt davon komplett unberührt.
	local cameraPosition = camera.CFrame.Position
	local lookAt = cameraPosition + direction * 100

	camera.CFrame = CFrame.lookAt(
		cameraPosition,
		lookAt
	)
end)

-- =========================================================
-- KEYBOARD INPUT
-- =========================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	local keyCode = input.KeyCode

	-- -----------------------------------------------------
	-- Taste gerade festlegen
	-- -----------------------------------------------------

	if waitingForKey then

		-- Escape = Abbrechen
		if keyCode == Enum.KeyCode.Escape then
			local oldName = waitingForKey
			waitingForKey = nil
			updateKeyButton(oldName)
			return
		end

		local positionName = waitingForKey

		if isKeyAlreadyUsed(keyCode, positionName) then
			keyButtons[positionName].Text = positionName .. ": bereits benutzt"
			task.delay(1, function()
				if waitingForKey == positionName then
					keyButtons[positionName].Text =
						positionName .. ": [ Taste drücken ]"
				end
			end)

			return
		end

		keybinds[positionName] = keyCode
		waitingForKey = nil

		updateKeyButton(positionName)

		return
	end

	-- -----------------------------------------------------
	-- Normale Keyboard-Bindings
	-- -----------------------------------------------------

	for positionName, assignedKey in pairs(keybinds) do
		if assignedKey == keyCode then
			setPosition(positionName)
			return
		end
	end

	-- Hub mit M öffnen/schließen
	if keyCode == Enum.KeyCode.M then
		hub.Visible = not hub.Visible
	end
end)

